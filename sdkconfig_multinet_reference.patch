# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Wake Word Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 禁用 AFE Wake Word，启用 Custom Wake Word
# CONFIG_USE_AFE_WAKE_WORD is not set
CONFIG_USE_CUSTOM_WAKE_WORD=y

CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=50

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# WakeNet Models (保留一个作为形式，实际代码中禁用)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 与参考工程一致，选择 wn9_hilexin
CONFIG_SR_WN_WN9_HILEXIN=y

# 禁用所有其他 WakeNet 模型
# CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS is not set
# CONFIG_SR_WN_WN9_ALEXA is not set
# CONFIG_SR_WN_WN9_HIESP is not set

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
